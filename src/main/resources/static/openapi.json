{
  "openapi": "3.1.0",
  "info": {
    "title": "Gorilla Escape — Players API",
    "version": "0.1.0",
    "description": "Primer incremento: jugadores humanos; sin scoring, cuentas ni autenticación. Uso local por defecto. Nombres duplicados permitidos; POST no es idempotente."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8090"
    }
  ],
  "paths": {
    "/api/players": {
      "get": {
        "operationId": "listPlayers",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página estable ordenada por createdAt e id",
            "headers": {
              "X-Request-Id": {
                "description": "UUID de correlación generado por servidor",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Server-Timing": {
                "description": "app;dur=milisegundos del backend, sin transferencia de red",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "limit",
                    "offset"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Player"
                      }
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "offset": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "JSON, nombre o parámetros inválidos",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Almacenamiento no disponible; no retry automático de POST",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Error interno sanitizado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createPlayer",
        "description": "Normaliza NFC y recorta extremos antes de validar. Nombre string de 1–40 unidades UTF-16, letras/marcas/números Unicode, espacio y _ . apostrofe guion. Rechaza propiedades desconocidas y claves JSON duplicadas. No incluye Idempotency-Key; repetir POST crea otra identidad.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "displayName"
                ],
                "additionalProperties": false,
                "properties": {
                  "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                },
                "example": {
                  "displayName": "Jugador Uno"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Jugador confirmado tras COMMIT; sin cabecera Location porque no hay GET individual en este incremento",
            "headers": {
              "X-Request-Id": {
                "description": "UUID de correlación generado por servidor",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "Server-Timing": {
                "description": "app;dur=milisegundos del backend, sin transferencia de red",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Player"
                }
              }
            }
          },
          "400": {
            "description": "JSON, nombre o parámetros inválidos",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Restricción de integridad",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Cuerpo superior a 4096 bytes",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "Se requiere application/json",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Error interno sanitizado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Almacenamiento no disponible; no retry automático de POST",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Player": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "requestId"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "violations": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
